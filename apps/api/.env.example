# Copie para .env e preencha localmente. Nunca commitar o .env real.

NODE_ENV=development
PORT=3000

# Comma-separated. Origens permitidas para CORS (ex.: scheme do app Expo em dev).
CORS_ORIGINS=http://localhost:19006

# Postgres local via docker-compose (docker compose up -d na raiz do monorepo).
DATABASE_URL=postgresql://minhasaude:minhasaude@localhost:5432/minhasaude

# Gere um valor forte localmente, ex.: openssl rand -hex 32
JWT_ACCESS_SECRET=troque-por-um-segredo-forte-de-pelo-menos-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Opcional. Só usada em produção (source token do BetterStack, Issue #8).
# Sem ela a API loga normalmente em stdout, sem encaminhar pro BetterStack.
BETTERSTACK_SOURCE_TOKEN=
