# Copie para .env e preencha localmente. Nunca commitar o .env real.

NODE_ENV=development
PORT=3000

# Comma-separated. Origens permitidas para CORS (ex.: scheme do app Expo em dev).
CORS_ORIGINS=http://localhost:19006

# Postgres local via docker-compose (docker compose up -d na raiz do monorepo).
DATABASE_URL=postgresql://minhasaude:minhasaude@localhost:5432/minhasaude
