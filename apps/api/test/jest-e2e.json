{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "roots": [
    "<rootDir>/test"
  ],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+.ts$": "ts-jest"
  },
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/database/migrations/**",
    "!src/database/seeds/**"
  ],
  "coverageDirectory": "<rootDir>/coverage-e2e",
  "coverageReporters": [
    "lcov",
    "text-summary"
  ]
}
