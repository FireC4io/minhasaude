{
  "name": "@minhasaude/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "App mobile Expo/React Native do Gota Vital.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "generate:api": "orval --config orval.config.ts",
    "reset-project": "node ./scripts/reset-project.js"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/work-sans": "^0.4.2",
    "@expo/ui": "~57.0.19",
    "@minhasaude/shared": "workspace:^",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/query-async-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "axios": "^1.20.0",
    "expo": "~57.0.24",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.2",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@minhasaude/config": "workspace:^",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "axios-mock-adapter": "^2.1.0",
    "babel-preset-expo": "~58.0.9",
    "eslint": "^10.12.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^30.5.2",
    "jest-expo": "~57.0.5",
    "orval": "^8.40.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2"
  },
  "jest": {
    "preset": "jest-expo",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.(ts|tsx)$",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "setupFiles": [
      "<rootDir>/../jest.setup.js"
    ],
    "coverageDirectory": "<rootDir>/../coverage"
  }
}
