{
  "name": "@minhasaude/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "App mobile Expo/React Native do Minha Saúde (Fase 3).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "generate:api": "orval --config orval.config.ts",
    "reset-project": "node ./scripts/reset-project.js"
  },
  "dependencies": {
    "@expo/ui": "~58.0.4",
    "@minhasaude/shared": "workspace:^",
    "@tanstack/react-query": "^5.103.2",
    "axios": "^1.20.0",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~58.0.1",
    "expo-image": "~57.0.5",
    "expo-linking": "~58.0.4",
    "expo-router": "~58.0.5",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@minhasaude/config": "workspace:^",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "axios-mock-adapter": "^2.1.0",
    "babel-preset-expo": "~57.0.12",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^30.5.1",
    "jest-expo": "~57.0.5",
    "orval": "^8.33.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.(ts|tsx)$",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
