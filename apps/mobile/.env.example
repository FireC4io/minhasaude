# Copie para .env.local e ajuste. Nunca commitar o .env real.

# URL base que o app chama em runtime. Padrão (sem essa variável): produção.
# Pra apontar pro backend local (docker compose + pnpm --filter api start:dev):
EXPO_PUBLIC_API_URL=http://localhost:3000

# Só usada por `pnpm generate:api` (orval), nunca entra no bundle do app.
# Pra gerar o client contra produção em vez do backend local:
# API_OPENAPI_URL=https://minhasaude-api.onrender.com/docs-json
API_OPENAPI_URL=http://localhost:3000/docs-json
