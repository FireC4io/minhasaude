{
  "name": "@minhasaude/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Tipos, enums, schemas Zod e catálogo de calculadoras compartilhados entre api e mobile.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage"
  },
  "devDependencies": {
    "@minhasaude/config": "workspace:^",
    "@types/jest": "^30.0.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.7.0"
  }
}
